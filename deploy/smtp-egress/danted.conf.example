logoutput: stderr

# This listener is private to the Docker network. Only stunnel reaches it.
internal: 0.0.0.0 port = 1080
external: eth0

clientmethod: none
socksmethod: none
# The container itself runs as UID/GID 10001 with all capabilities dropped.
# Do not set user.notprivileged here: Dante would need root to change identity.

client pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: error
}

# Never use the runner to reach loopback, private, link-local, benchmark, or
# documentation addresses. IPv6 is intentionally disabled for the first run.
socks block {
    from: 0.0.0.0/0 to: 0.0.0.0/8
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 10.0.0.0/8
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 100.64.0.0/10
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 127.0.0.0/8
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 169.254.0.0/16
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 172.16.0.0/12
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 192.168.0.0/16
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 192.0.0.0/24
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 198.18.0.0/15
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 198.51.100.0/24
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 203.0.113.0/24
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 224.0.0.0/4
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: 240.0.0.0/4
    command: connect
    protocol: tcp
    log: connect error
}
socks block {
    from: 0.0.0.0/0 to: ::/0
    command: connect
    protocol: tcp
    log: connect error
}

# The runner only permits secure SMTP and IMAP. Any unmatched destination is
# denied by Dante.
socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0 port = 465
    command: connect
    protocol: tcp
    log: connect error
}
socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0 port = 587
    command: connect
    protocol: tcp
    log: connect error
}
socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0 port = 2525
    command: connect
    protocol: tcp
    log: connect error
}
socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0 port = 993
    command: connect
    protocol: tcp
    log: connect error
}
