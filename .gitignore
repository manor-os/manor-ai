# ── Secrets — NEVER track anywhere ──
.env
.env.local
.env.production
.env.cloud
.env.oss-test
.secrets/

# Cloud-only paths (packages/cloud/, caddy/, docker-compose.cloud.yml,
# scripts/cloud/, apps/api/routers/billing.py, etc.) ARE tracked in
# the private cloud repo. They get stripped when mirroring to the
# public OSS repo — see .ossexclude for the strip list and the
# (future) .github/workflows/oss-mirror.yml that consumes it.

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
.venv*/
venv/
*.egg-info/
*.egg
dist/
build/
.pytest_cache/

# ── Node ──
node_modules/
.tmp-npm-cache/
apps/web/dist/
docs-site/.docusaurus/
docs-site/build/
.next/
*.tsbuildinfo

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ── Claude Code worktrees (ephemeral, not source) ──
.claude/worktrees/

# ── Docker ──
docker/data/
docker-compose.oss-test.yml

# ── Alembic / DB ──
*.db
*.sqlite
.cloud.prod.env


.claude
.cursor

.playwright-mcp

# ── Scratch / build artifacts (sample generation, previews, screenshots) ──
tmp/
artifacts/
.superpowers/
# git worktrees
.worktrees/

# Static Integration sources must remain Git-visible even when a developer's
# lower-precedence .git/info/exclude contains stale workspace-only entries.
!packages/core/ai/mcp/alpaca_market_data.py
!packages/core/ai/mcp/alpha_vantage.py
!packages/core/ai/mcp/twelve_data.py
!packages/core/ai/skills/mcp_alpaca_market_data/
!packages/core/ai/skills/mcp_alpaca_market_data/**
!packages/core/ai/skills/mcp_alpha_vantage/
!packages/core/ai/skills/mcp_alpha_vantage/**
!packages/core/ai/skills/mcp_twelve_data/
!packages/core/ai/skills/mcp_twelve_data/**
