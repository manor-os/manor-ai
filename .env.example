# Manor AI Configuration
# Copy this to .env and fill in your values

# ── LLM ──
# OSS model calls are BYOK-only. Configure native provider keys in Settings.
# Primary-role fallback model. Override per user/entity in Settings; cloud
# admins can also set a platform default in Admin → Models, which takes
# precedence over this value. Leave unset to use the shipped default.
LLM_MODEL=openai/gpt-5.6-luna

# ── Database ──
DATABASE_URL=postgresql+asyncpg://manor:manor_secret@postgres:5432/manor
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://manor:manor_secret@postgres:5432/manor

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Knowledge embedding recovery ──
# A processing document with no heartbeat for this long is reclaimed.
EMBEDDING_PROCESSING_STALE_SECONDS=300
# Reuse completed chunk embeddings across worker restarts; 0 disables caching.
EMBEDDING_CACHE_TTL_SECONDS=86400
# A pending document with no task start is redispatched after this delay.
EMBEDDING_PENDING_STALE_SECONDS=120
# After this many stale-run recoveries, stop retrying and mark it failed.
EMBEDDING_MAX_STALE_RECOVERIES=3
EMBEDDING_SWEEP_LIMIT=50

# ── Knowledge hot cache ──
# Metadata/list results stay client/tool cached; on-demand text, small files,
# and generated thumbnails use a bounded, versioned Redis cache. A value of 0
# disables that cache tier. Entries larger than the byte cap bypass Redis.
KNOWLEDGE_CONTENT_CACHE_TTL_SECONDS=172800
KNOWLEDGE_THUMBNAIL_CACHE_TTL_SECONDS=172800
KNOWLEDGE_DOWNLOAD_CACHE_TTL_SECONDS=172800
KNOWLEDGE_CACHE_MAX_ENTRY_BYTES=1048576

# ── Single-server emergency controls ──
# OSS-safe defaults stay conservative. Cloud production can override these in
# .env or docker-compose.cloud.yml after measuring CPU, p95, and DB connections.
API_WORKERS=1
API_LIMIT_CONCURRENCY=120
API_BACKLOG=256
API_TIMEOUT_KEEP_ALIVE=5

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800

# Redis service memory guard. Keep noeviction for shared single-machine Redis.
# In K8s/production, split cache, Celery, and JuiceFS metadata Redis roles
# instead of putting all responsibilities behind one evicting instance.
REDIS_MAXMEMORY=0
REDIS_MAXMEMORY_POLICY=noeviction

# Global/chat limiters are opt-in. To enable shared limits across API workers:
# RATE_LIMIT_ENABLED=true
# CHAT_RATE_LIMIT_ENABLED=true
# REDIS_RATE_LIMIT_ENABLED=true
# CHAT_RATE_LIMIT_REQUESTS=10
# API_RATE_LIMIT_REQUESTS=180
RATE_LIMIT_ENABLED=false
CHAT_RATE_LIMIT_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_ACCOUNT_FAILURE_LIMIT=10
AUTH_ACCOUNT_FAILURE_WINDOW_SECONDS=900
AUTH_IP_FAILURE_LIMIT=80
AUTH_IP_FAILURE_WINDOW_SECONDS=3600
AUTH_FALLBACK_MAX_BUCKETS=10000
AUTH_FALLBACK_CLEANUP_INTERVAL_SECONDS=60
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_REQUESTS=200
API_RATE_LIMIT_WINDOW_SECONDS=60

# Emergency degraded mode. When DEGRADED_MODE=true, high-cost routes return
# 503 with code=degraded_mode; health/config/login/basic reads keep working.
DEGRADED_MODE=false
DEGRADED_DISABLE_CHAT_STREAM=true
DEGRADED_DISABLE_SANDBOX=true
DEGRADED_DISABLE_MEDIA_GENERATION=true
DEGRADED_DISABLE_LARGE_UPLOADS=true

# ── Storage ──
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=manor

# ── JuiceFS (distributed file storage on MinIO) ──
# JuiceFS uses Redis for metadata and MinIO for data blocks.
# The juicefs service in docker-compose handles format + mount automatically.
MANOR_FS_ENABLED=true
MANOR_FS_ROOT=/mnt/manor
MANOR_FS_MOUNT_MANAGED=juicefs
JUICEFS_META_URL=redis://redis:6379/1
JUICEFS_STORAGE=minio
JUICEFS_BUCKET=http://minio:9000/manor
JUICEFS_ACCESS_KEY=minioadmin
JUICEFS_SECRET_KEY=minioadmin

# ── Sandbox ──
SANDBOX_SERVICE_URL=http://manor-sandbox:8000
SHELL_SANDBOX_ENABLED=true
SANDBOX_MAX_SANDBOXES=5
SANDBOX_IDLE_TIMEOUT=600
SANDBOX_EXEC_TIMEOUT=120
SANDBOX_INSTANCE_MAX_EXECUTING=0
SANDBOX_GLOBAL_MAX_ACTIVE=0
SANDBOX_GLOBAL_MAX_EXECUTING=0

# ── Service roles / stream concurrency ──
MANOR_SERVICE_ROLE=api
# In cloud/K8s, startup repair/backfill/bootstrap jobs need one explicit owner.
# Local OSS API keeps single-machine compatibility by default.
MANOR_STARTUP_SIDE_EFFECTS_OWNER=false
# In cloud/K8s, Telegram polling should be owned by one explicit runner/worker.
# Local OSS API keeps auto polling compatibility when PUBLIC_BASE_URL is not HTTPS.
MANOR_TELEGRAM_POLLING_RUNNER=false
CHAT_STREAM_CONCURRENCY_ENABLED=true
CHAT_STREAM_MAX_CONCURRENCY_GLOBAL=60
CHAT_STREAM_MAX_CONCURRENCY_PER_INSTANCE=20
CHAT_STREAM_QUEUE_TIMEOUT_SECONDS=0.5
CHAT_STREAM_SLOT_TTL_SECONDS=900

# ── Auth ──
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=manor-api
JWT_AUDIENCE=manor-api
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=false
UPLOAD_AV_REQUIRED=false
# Cloud Compose overrides this to the internal `clamav` service and requires it.
# Self-hosters can opt in with:
# docker compose -f docker-compose.yml -f docker-compose.av.yml up -d
# Or set a reachable clamd host.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
PASSWORD_POLICY_ENFORCED=true
PASSWORD_MIN_LENGTH=12
CORS_ALLOWED_ORIGINS=http://localhost:18080

# ── OAuth (Google SSO) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Drive (Picker API for Knowledge page) ──
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Enable "Google Picker API" and "Google Drive API" in your project
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=

# ── Email (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_ENABLED=false
# Optional SOCKS egress. Self-hosted and local Compose keep this as direct.
SMTP_EGRESS_MODE=direct
SMTP_SOCKS_HOST=
SMTP_SOCKS_PORT=1080


# ── Web Search (agent tool) ──
# Engine: "serper" or "tavily"
SEARCH_ENGINE=serper
SEARCH_API_KEY=

# ── Live market data (generated Dashboard modules) ──
FINNHUB_API_KEY=

# ── Deployment mode ──
# "oss" = self-hosted mode
DEPLOYMENT_MODE=oss
# First three octets of Manor's private Compose /24. Change this single value
# when 172.30.0.0/24 conflicts with another local network.
MANOR_DOCKER_NETWORK_PREFIX=172.30.0

# Workflow launch gate. Local/dev environments enable Flows by default;
# prod/production shows the disabled "Soon" navigation item unless enabled.
# FLOWS_AVAILABLE=true
# Local/dev environments omit the "Soon" label by default. Production keeps
# it until release; set this explicitly to override either environment default.
# FLOWS_RELEASED=true


VAULT_TOKEN=
VAULT_TRANSIT_KEY=manor-keys

# ── Channel integrations ──
# Public base URL the providers' servers can reach this deployment at.
# Must be https:// in production. Used to build inbound webhook URLs and
# signed public file URLs.
# Also required for video generation from local/Knowledge reference images:
# Manor signs /api/v1/fs/public/{token} URLs that video providers fetch.
# In local dev, text-to-video works without HTTPS; image-to-video needs a
# public HTTPS tunnel or an already public https:// reference image URL.
PUBLIC_BASE_URL=http://localhost:8010

# Public web URL. The default Docker compose web service listens on 18080 and
# proxies /api to the API container.
APP_URL=http://localhost:18080


# Telegram inbound mode: webhook | polling | auto (default).
# - webhook: integration save registers a Telegram webhook; needs HTTPS
# - polling: async getUpdates loop in the API process; no public URL needed
# - auto:    webhook when PUBLIC_BASE_URL is https, else polling
TELEGRAM_MODE=auto

# OAuth apps — register at each provider's developer portal, set the
# callback URL to {APP_URL}/api/v1/integrations/oauth/{server_key}/callback.
# PUBLIC_BASE_URL is reserved for inbound webhooks.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Robinhood Trading MCP uses a public PKCE client (no CLIENT_SECRET).
# Register {APP_URL}/api/v1/integrations/oauth/robinhood/callback with Robinhood.
# A client ID configures the app; each user still completes account consent.
ROBINHOOD_CLIENT_ID=

# Microsoft 365 (one Azure AD App Registration powers Outlook +
# OneDrive + MS Calendar + MS Teams + MS Excel).
# Get from https://portal.azure.com → Azure Active Directory →
# App registrations → New registration → Web platform.
# Set redirect URI to {APP_URL}/api/v1/integrations/oauth/outlook/callback
# (or one per server_key; they all share the same client_id/secret).
# Required Microsoft Graph permissions (delegated):
#   Mail.Read, Mail.ReadWrite, Mail.Send,
#   Files.ReadWrite, Files.ReadWrite.All,
#   Calendars.ReadWrite, MailboxSettings.Read,
#   Team.ReadBasic.All, Channel.ReadBasic.All,
#   ChannelMessage.Read.All, ChannelMessage.Send,
#   Chat.ReadWrite, OnlineMeetings.ReadWrite, Presence.ReadWrite,
#   User.Read, offline_access
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Tenant: 'common' (default — accepts work/school + personal accounts),
# 'organizations' (work/school only), 'consumers' (MSA only), or a
# specific Azure AD tenant GUID for single-tenant deployments.
MS_TENANT=common

# Discord (OAuth client + bot + interactions signature)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=        # ed25519 public key, hex — for interaction signature verify
DISCORD_BOT_TOKEN=         # required if the bot sends messages

# Twilio webhook verification. Account credentials are supplied per Integration.
# Only enable for local/dev/test fixtures; staging and production must verify
# X-Twilio-Signature regardless of this flag.
TWILIO_ALLOW_UNSIGNED_LOCAL=false

# WhatsApp Cloud API fixed app-level webhook. Nango supplies the OAuth
# access token/phone id at runtime; these Meta app webhook values are not
# guaranteed to be part of an OAuth connection response.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Browser and Twilio share one Realtime route. Primary AI native OpenAI BYOK is
# preferred; STT/Voice role keys stay scoped to the turn-based Browser fallback.
OPENAI_REALTIME_MODEL=gpt-realtime
VERCEL_REALTIME_MODEL=openai/gpt-realtime-mini
OPENAI_API_KEY=            # optional managed OpenAI route fallback

# ── Nango (200+ SaaS OAuth aggregator) ──
# Start the bundled Nango server with:
#   docker compose --profile nango up -d nango-server
# Then visit http://localhost:3003, set the admin password, and
# Settings → copy the "Secret Key" into NANGO_SECRET_KEY below.
# Once set, every Integration card on /integrations whose server_key
# matches a Nango "provider config key" will show a Connect button
# that opens Nango's OAuth popup. Leave empty to disable Nango.
NANGO_BASE_URL=http://nango-server:3003
# Public hostname users see for OAuth callbacks + SaaS webhooks.
# Local dev: leave empty (Nango uses redirectmeto.com auto-forward).
# Prod: set to https://nango.<your-domain> — must match a DNS record
# pointing to your server, and Caddy must be running (--profile prod).
NANGO_PUBLIC_URL=
NANGO_SECRET_KEY=
NANGO_PUBLIC_KEY=
# A distinct 64-character lowercase-hex key for Nango Connect HMAC and
# the webhook URL token. Generate with: openssl rand -hex 32
NANGO_CONNECT_HMAC_KEY=
# Legacy Compose compatibility variable. Nango 0.36 does not sign outbound
# webhook requests with it; use NANGO_CONNECT_HMAC_KEY instead.
NANGO_WEBHOOK_SECRET=
# Public URL Nango should POST webhooks to. Defaults to the docker
# compose service URL (http://manor-api:8000/api/v1/nango/webhook). Manor
# appends a derived nango_webhook_token because Nango 0.36 has no signature
# header. Override for production with your internal API URL.
NANGO_WEBHOOK_URL=

# ── Nango platforms (auto-bootstrapped on startup) ──
# For every Nango-aggregated platform you want available, add the
# pair below. On API startup these get pushed into Nango's admin DB
# via its API — no need to click around in the Nango admin UI.
#
# Pattern:  NANGO_PROVIDER_<PROVIDER>_CLIENT_ID
#           NANGO_PROVIDER_<PROVIDER>_CLIENT_SECRET
#           NANGO_PROVIDER_<PROVIDER>_SCOPES   (optional, space-separated)
#           NANGO_PROVIDER_<PROVIDER>_KEY      (optional, defaults to <PROVIDER>)
#           NANGO_PROVIDER_<PROVIDER>_PROVIDER (optional, defaults to <PROVIDER>)
#
# Example — HubSpot:
# NANGO_PROVIDER_HUBSPOT_CLIENT_ID=
# NANGO_PROVIDER_HUBSPOT_CLIENT_SECRET=
# NANGO_PROVIDER_HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write oauth
# Ready-to-fill provider keys used by the remaining integrations. Uncomment
# a complete client-id/secret pair together with scopes when enabling a Nango
# provider; partial pairs are rejected by the bootstrap health report.
# NANGO_PROVIDER_OUTLOOK_CLIENT_ID=
# NANGO_PROVIDER_OUTLOOK_CLIENT_SECRET=
# NANGO_PROVIDER_OUTLOOK_SCOPES=offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send
# NANGO_PROVIDER_MS_TEAMS_CLIENT_ID=
# NANGO_PROVIDER_MS_TEAMS_CLIENT_SECRET=
# NANGO_PROVIDER_MS_TEAMS_SCOPES=offline_access User.Read Team.ReadBasic.All Channel.ReadBasic.All ChannelMessage.Read.All ChannelMessage.Send Chat.ReadWrite OnlineMeetings.ReadWrite Presence.ReadWrite
# NANGO_PROVIDER_GMAIL_CLIENT_ID=
# NANGO_PROVIDER_GMAIL_CLIENT_SECRET=
# NANGO_PROVIDER_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send
# NANGO_PROVIDER_GOOGLE_CALENDAR_CLIENT_ID=
# NANGO_PROVIDER_GOOGLE_CALENDAR_CLIENT_SECRET=
# NANGO_PROVIDER_GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
# NANGO_PROVIDER_GOOGLE_DRIVE_CLIENT_ID=
# NANGO_PROVIDER_GOOGLE_DRIVE_CLIENT_SECRET=
# NANGO_PROVIDER_GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive
# X / Twitter. Manor uses the canonical provider key ``twitter_x``;
# Nango's provider config key remains ``twitter``. Keep this disabled while
# staging uses Direct OAuth (X_CLIENT_ID/X_CLIENT_SECRET).
# NANGO_PROVIDER_TWITTER_CLIENT_ID=
# NANGO_PROVIDER_TWITTER_CLIENT_SECRET=
# NANGO_PROVIDER_TWITTER_SCOPES=tweet.read tweet.write users.read like.read like.write follows.read follows.write offline.access
# WhatsApp Business Login (Meta). The provider config key is fixed as
# ``whatsapp`` so the Integrations card can open Nango Connect directly.
# Create a Facebook Login for Business configuration with WhatsApp Embedded
# Signup and set its configuration id below.
# NANGO_PROVIDER_WHATSAPP_CLIENT_ID=
# NANGO_PROVIDER_WHATSAPP_CLIENT_SECRET=
# NANGO_PROVIDER_WHATSAPP_PROVIDER=facebook
# NANGO_PROVIDER_WHATSAPP_CONFIG_ID=
# NANGO_PROVIDER_WHATSAPP_SCOPES=whatsapp_business_management,whatsapp_business_messaging
#
# Where to get OAuth credentials per platform:
#   HubSpot   → https://app.hubspot.com/developer/ → Apps
#   Linear    → Linear Settings → API → OAuth applications
#   Notion    → https://www.notion.so/my-integrations
#   Salesforce → Setup → Apps → App Manager → New Connected App
#   Stripe    → https://dashboard.stripe.com/apps-oauth
#   Shopify   → https://partners.shopify.com → Apps
#
# Redirect URI to enter at the platform's developer portal:
#   ${NANGO_PUBLIC_URL}/oauth/callback
# (e.g. http://localhost:3003/oauth/callback in local dev)

# ── Integration preview flag ──
# Manor ships a few integrations as "Coming Soon" (Facebook, Gmail,
# Google Calendar/Drive, PayPal, …) — they're functionally complete but
# gated until each provider's production review lands (Meta App Review,
# Google OAuth verification, etc.). Set this env var on dev / staging
# to surface specific providers + channels for Test User work without
# opening them to real users on prod.
#
# Comma-separated provider keys (case-insensitive), e.g.:
#   MANOR_PREVIEW_INTEGRATIONS=facebook,gmail
#   MANOR_PREVIEW_CHANNELS=facebook
# Leave empty in production until the upstream review approves the
# provider + scope set.
MANOR_PREVIEW_INTEGRATIONS=
MANOR_PREVIEW_CHANNELS=

# ── Facebook (Meta) — example provider config ──
# Get App ID / App Secret from https://developers.facebook.com →
# My Apps → your app → App settings → Basic. Add Facebook Login as a
# product, set Valid OAuth Redirect URIs to ${NANGO_PUBLIC_URL}/oauth/callback,
# and (for production) submit the listed scopes to Meta App Review.
# To unlock the Pages + Messenger surface in Manor:
# NANGO_PROVIDER_FACEBOOK_CLIENT_ID=
# NANGO_PROVIDER_FACEBOOK_CLIENT_SECRET=
# NANGO_PROVIDER_FACEBOOK_SCOPES=email,public_profile,pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,pages_messaging
# To also unlock Instagram Business (PR #13's IG tools), append:
#   ,instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_insights

# ── Minutes app (meeting notes MCP bridge) ──
# Optional explicit service key for the Minutes MCP endpoint — must match a
# MEETING_NOTE_TAKER_API_KEY configured on the Minutes deployment. When left
# unset, the bridge derives the key from the minutes-cloud OAuth client
# secret (MANOR_OAUTH_CLIENT_MINUTES_CLOUD_SECRET) that Minutes login
# already requires, and the Minutes backend accepts the same derivation —
# so normally nothing needs to be set here.
MEETING_NOTE_TAKER_API_KEY=
# Minutes MCP endpoint (default shown; override for a self-hosted Minutes)
MINUTES_MCP_URL=https://minutes.manorai.xyz/api/mcp/
