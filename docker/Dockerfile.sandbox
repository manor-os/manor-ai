# Sandbox container base image for skill execution.
#
# This is the image that runs INSIDE each sandboxed Docker container
# created by the sandbox-service. It is NOT the service itself.
# Skill scripts are injected into a running container of this image
# and executed in isolation.
#
# Build (once, before starting the stack):
#   docker build -t sandbox-skill:latest -f docker/Dockerfile.sandbox .
#
# The sandbox-service uses this image via the SANDBOX_IMAGE env var.

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # npm cache and global prefix point to writable tmpfs locations.
    # /home/sandbox is mounted as tmpfs at runtime (read-only root fs).
    NPM_CONFIG_CACHE=/home/sandbox/.npm \
    NPM_CONFIG_PREFIX=/home/sandbox/.npm-global \
    PATH="/home/sandbox/.npm-global/bin:${PATH}"

# Install base tools + Node.js from Debian.
#
# This used to add the NodeSource repo via `curl setup_20.x | bash -`. That
# script exits 0 even when it fails: on 2026-07-27 its signing-key download
# started returning 403, so the repo was never added, `apt-get install nodejs`
# quietly took Debian's own package — which does NOT ship npm — and the build
# died three steps later on `npm: not found`. Debian trixie ships Node 20.19,
# exactly the major this image wants, so the third-party repo bought nothing
# and cost us every deploy.
#
# `node --version` and `npm --version` at the end are the guard: if a future
# base image stops providing either, THIS layer fails instead of something
# downstream.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    ripgrep \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /skill

CMD ["sleep", "infinity"]
