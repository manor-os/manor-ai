FROM node:22.13-alpine AS build

ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_DRIVE_API_KEY
ARG BUILD_VERSION=dev
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_DRIVE_API_KEY=$VITE_GOOGLE_DRIVE_API_KEY
ENV BUILD_VERSION=$BUILD_VERSION
ENV NODE_OPTIONS=--max-old-space-size=4096

WORKDIR /app
COPY apps/web/package*.json ./
COPY apps/web/vendor/ ./vendor/
RUN npm config set registry https://registry.npmjs.org/ \
    && for attempt in 1 2 3; do \
         rm -rf node_modules; \
         npm ci --include=dev --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 \
         && test -x node_modules/.bin/tsc \
         && exit 0; \
         echo "npm ci attempt ${attempt} failed; retrying..."; \
         sleep 10; \
       done; \
       exit 1
COPY apps/web/ .
RUN npm run build

# brotli_static only sends files compressed at build time, so it links no
# compression library. The module is built against this exact nginx version.
FROM nginx:alpine AS brotli-module
ARG NGX_BROTLI_COMMIT=53e0fb55f250f48fe80c0ddbf6c0f7103cdbaae1
RUN apk add --no-cache curl gcc linux-headers make musl-dev pcre2-dev zlib-dev \
    && curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" | tar xz -C /tmp \
    && curl -fsSL "https://github.com/google/ngx_brotli/archive/${NGX_BROTLI_COMMIT}.tar.gz" | tar xz -C /tmp \
    && cd "/tmp/nginx-${NGINX_VERSION}" \
    && ./configure --with-compat "--add-dynamic-module=/tmp/ngx_brotli-${NGX_BROTLI_COMMIT}/static" \
    && make modules \
    && cp objs/ngx_http_brotli_static_module.so /ngx_http_brotli_static_module.so

FROM nginx:alpine
COPY --from=brotli-module /ngx_http_brotli_static_module.so /usr/lib/nginx/modules/ngx_http_brotli_static_module.so
RUN sed -i '1i load_module modules/ngx_http_brotli_static_module.so;' /etc/nginx/nginx.conf
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
ENV MANOR_API_UPSTREAM=manor-api:8000
ENV MANOR_CHAT_UPSTREAM=manor-chat:8000
ENV MANOR_WEB_LISTEN_PORT=80
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx-app-security-headers.conf /etc/nginx/snippets/manor-app-security-headers.conf
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
