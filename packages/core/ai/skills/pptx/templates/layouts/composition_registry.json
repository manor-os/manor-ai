    "comparison": {"use": "Two alternatives with the same comparison fields", "avoid": "Long prose", "density": "medium", "regions": [{"id": "header", "x": 64, "y": 48, "width": 1152, "height": 140}, {"id": "left", "x": 70, "y": 220, "width": 540, "height": 410}, {"id": "right", "x": 670, "y": 220, "width": 540, "height": 410}]},
    "metric-focus": {"use": "One verified quantitative outcome", "avoid": "Unverified figures", "density": "sparse", "regions": [{"id": "header", "x": 64, "y": 48, "width": 1152, "height": 140}, {"id": "metric", "x": 100, "y": 230, "width": 560, "height": 340}, {"id": "context", "x": 740, "y": 230, "width": 430, "height": 340}]},
